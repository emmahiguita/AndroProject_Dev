{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AndroProject",
  "version": "2.1.0",
  "identifier": "com.androproject.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://127.0.0.1:3001"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AndroProject v2.1.0 — Native Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0b0e17"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../public/icon.png"
    ]
  }
}
